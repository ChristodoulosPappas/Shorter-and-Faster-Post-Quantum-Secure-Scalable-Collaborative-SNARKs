# =============================================================================
# cocoSNARK Benchmark Framework Configuration
# =============================================================================

# --- Azure Infrastructure Settings ---
AZ_RG="sPQcocoSNARK_benchmarks"
AZ_LOCATION="southeastasia"
AZ_VNET="sPQcocoSNARK-vnet"
AZ_SUBNET="default"
AZ_NSG="sPQcocoSNARK-nsg"
AZ_VM_BASE="sPQcocoSNARK"

AZ_IMAGE="canonical:ubuntu-24_04-lts:server:latest"
AZ_SIZE_WORKER="Standard_D4as_v6"
AZ_SIZE_LEADER="Standard_D16as_v5"

# --- Project & Binary Settings ---
TARGET_BIN="./build/src/pigeon"
REMOTE_REPO_DIR="~/sPQcocoSNARK"

# --- MPI & Network Defaults ---
DEFAULT_NUM_VMS=32
MPI_IFACE="eth0"
# MPI_KEY_PATH="~/.ssh/sPQcocoSNARK_mpi_key_128" # Uncomment to override
# BENCHMARK_USER="azureuser"                # Uncomment to override
